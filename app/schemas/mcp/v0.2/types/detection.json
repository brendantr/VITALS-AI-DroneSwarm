{
  "$id": "https://vitals.dev/schemas/mcp/v0.2/types/detection.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "event_id", "ts", "type", "source", "payload"],
  "properties": {
    "schema": { "const": "mcp.v0.2" },
    "event_id": { "type": "string", "minLength": 8 },
    "ts": { "type": "string" },
    "type": { "const": "MCP.Detection" },
    "corr_id": { "type": "string" },
    "idempotency_key": { "type": "string", "minLength": 8 },
    "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
    "source": { "$ref": "../base.json#/$defs/source" },
    "geo": { "$ref": "../base.json#/$defs/geo" },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "text": { "type": "string" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "confidence"],
      "properties": {
        "label": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "bbox_xyxy": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "number" }
        },
        "track_id": { "type": "string" },
        "sensor": { "type": "string" },
        "sector": { "type": "string" },
        "uav_id": { "type": "string" },
        "frame_ts": { "type": "string" }
      }
    }
  }
}
