{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vitals.local/schemas/agentb.api.v0.1/query_response.json",
  "title": "Agent B Query Response v0.1",
  "type": "object",
  "required": ["schema", "type", "ok", "query_id", "ts"],
  "properties": {
    "schema": { "const": "agentb.api.v0.1" },
    "type": { "const": "AgentB.QueryResponse" },

    "ok": { "type": "boolean" },
    "query_id": { "type": "string", "minLength": 8 },
    "ts": { "type": "string", "format": "date-time" },

    "corr_id": { "type": "string" },

    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rank", "id", "text"],
        "properties": {
          "rank": { "type": "integer", "minimum": 1 },
          "id": { "type": "string" },
          "text": { "type": "string" },
          "metadata": { "type": "object" },
          "score": { "type": ["number", "null"] }
        },
        "additionalProperties": false
      },
      "default": []
    },

    "stats": {
      "type": "object",
      "properties": {
        "n_results": { "type": "integer" },
        "k_init": { "type": "integer" },
        "rerank": { "type": "boolean" },
        "latency_ms": { "type": "number" }
      },
      "additionalProperties": false
    },

    "error": {
      "type": "object",
      "description": "Present when ok=false",
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "detail": { "type": "object" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}