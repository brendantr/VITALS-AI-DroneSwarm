{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vitals.local/schemas/agentb.api.v0.1/query_request.json",
  "title": "Agent B Query Request v0.1",
  "type": "object",
  "required": ["schema", "type", "query"],
  "properties": {
    "schema": { "const": "agentb.api.v0.1" },
    "type": { "const": "AgentB.QueryRequest" },

    "query": { "type": "string", "minLength": 1 },

    "n_results": { "type": "integer", "minimum": 1, "maximum": 100, "default": 8 },
    "k_init": { "type": "integer", "minimum": 1, "maximum": 500, "default": 50 },

    "rerank": { "type": "boolean", "default": false },

    "where": {
      "type": "object",
      "description": "Chroma metadata filter (exact-match filters recommended for v0.1).",
      "default": {}
    },

    "include_scores": { "type": "boolean", "default": true },
    "include_metadata": { "type": "boolean", "default": true },

    "corr_id": { "type": "string" },

    "client": {
      "type": "object",
      "properties": {
        "component": { "type": "string" },
        "instance": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}