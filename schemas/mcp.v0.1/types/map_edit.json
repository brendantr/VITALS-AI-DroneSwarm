{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vitals.local/schemas/mcp.v0.1/types/map_edit.json",
  "title": "MCP.MapEdit v0.1",
  "type": "object",
  "properties": {
    "type": { "const": "MCP.MapEdit" },
    "payload": {
      "type": "object",
      "required": ["edit_kind"],
      "properties": {
        "edit_kind": {
          "type": "string",
          "enum": ["DefineSector", "UpdateSector", "DefineNFZ", "UpdateNFZ", "SetPriority"]
        },
        "name": { "type": "string", "description": "Sector/NFZ name or identifier" },
        "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
        "polygon_wgs84": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["lat", "lon"],
            "properties": {
              "lat": { "type": "number" },
              "lon": { "type": "number" }
            },
            "additionalProperties": false
          },
          "minItems": 3
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["type", "payload"]
}