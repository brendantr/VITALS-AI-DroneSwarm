{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vitals.local/schemas/mcp.v0.1/types/detection.json",
  "title": "MCP.Detection v0.1",
  "type": "object",
  "properties": {
    "type": { "const": "MCP.Detection" },
    "payload": {
      "type": "object",
      "required": ["label", "confidence"],
      "properties": {
        "label": { "type": "string", "description": "e.g., person, vehicle, debris, smoke" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "bbox_xyxy": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4,
          "description": "[x1,y1,x2,y2] in image pixels if applicable"
        },
        "track_id": { "type": "string" },
        "sensor": { "type": "string", "default": "rgb" },
        "sector": { "type": "string", "description": "Operator-defined sector identifier (e.g., B4)" },
        "uav_id": { "type": "string" },
        "frame_ts": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  },
  "required": ["type", "payload"]
}