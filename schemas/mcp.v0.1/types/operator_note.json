{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vitals.local/schemas/mcp.v0.1/types/operator_note.json",
  "title": "MCP.OperatorNote v0.1",
  "type": "object",
  "properties": {
    "type": { "const": "MCP.OperatorNote" },
    "payload": {
      "type": "object",
      "required": ["note"],
      "properties": {
        "note": { "type": "string" },
        "author": { "type": "string", "default": "operator" },
        "sector": { "type": "string" },
        "severity": { "type": "string", "enum": ["info", "warning", "critical"], "default": "info" }
      },
      "additionalProperties": false
    }
  },
  "required": ["type", "payload"]
}