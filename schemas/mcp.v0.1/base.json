{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vitals.local/schemas/mcp.v0.1/base.json",
  "title": "MCP Base Envelope v0.1",
  "type": "object",
  "required": ["schema", "event_id", "ts", "type", "source", "payload"],
  "properties": {
    "schema": { "const": "mcp.v0.1" },
    "event_id": { "type": "string", "minLength": 8 },
    "ts": { "type": "string", "format": "date-time" },
    "type": {
      "type": "string",
      "enum": ["MCP.Detection", "MCP.Caption", "MCP.OperatorNote", "MCP.MapEdit"]
    },
    "corr_id": { "type": "string" },
    "span_id": { "type": "string" },
    "priority": { "type": "integer", "minimum": 0, "maximum": 100, "default": 50 },
    "source": {
      "type": "object",
      "required": ["system", "component"],
      "properties": {
        "system": { "type": "string", "default": "VITALS" },
        "component": {
          "type": "string",
          "enum": ["AgentA", "AgentB", "AgentC", "AgentD", "GUIAdapter", "MAVLinkRouter", "UAV"]
        },
        "instance": { "type": "string" }
      },
      "additionalProperties": false
    },
    "geo": {
      "type": "object",
      "properties": {
        "lat": { "type": "number" },
        "lon": { "type": "number" },
        "alt_m": { "type": "number" },
        "frame": { "type": "string", "default": "WGS84" }
      },
      "additionalProperties": false
    },
    "tags": { "type": "array", "items": { "type": "string" }, "default": [] },
    "text": {
      "type": "string",
      "description": "Canonical natural-language string for embedding. Optional but recommended for Agent B."
    },
    "payload": { "type": "object" }
  },
  "additionalProperties": false
}