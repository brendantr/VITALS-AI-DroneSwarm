{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vitals.local/schemas/acp.v0.1/types/result.json",
  "title": "ACP.Result v0.1",
  "type": "object",
  "properties": {
    "type": { "const": "ACP.Result" },
    "payload": {
      "type": "object",
      "required": ["ref_event_id", "outcome"],
      "properties": {
        "ref_event_id": { "type": "string" },
        "outcome": { "type": "string", "enum": ["success", "partial", "failure"] },
        "summary": { "type": "string" },
        "artifacts": {
          "type": "object",
          "properties": {
            "mission_plan_id": { "type": "string" },
            "waypoint_count": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["type", "payload"]
}