{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vitals.local/schemas/acp.v0.1/types/ack.json",
  "title": "ACP.Ack v0.1",
  "type": "object",
  "properties": {
    "type": { "const": "ACP.Ack" },
    "payload": {
      "type": "object",
      "required": ["ref_event_id", "status"],
      "properties": {
        "ref_event_id": { "type": "string" },
        "status": { "type": "string", "enum": ["accepted", "rejected", "queued"] },
        "message": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "required": ["type", "payload"]
}