{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vitals.local/schemas/acp.v0.1/types/status.json",
  "title": "ACP.Status v0.1",
  "type": "object",
  "properties": {
    "type": { "const": "ACP.Status" },
    "payload": {
      "type": "object",
      "required": ["ref_event_id", "state"],
      "properties": {
        "ref_event_id": { "type": "string" },
        "state": { "type": "string", "enum": ["proposed", "approved", "planning", "executing", "paused", "completed", "failed"] },
        "progress_pct": { "type": "integer", "minimum": 0, "maximum": 100 },
        "detail": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "required": ["type", "payload"]
}